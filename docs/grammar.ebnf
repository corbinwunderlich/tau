/* Syntax */

Ast ::= Stmt+

Stmt         ::= Block
               | FunctionDecl
               | VarDecl
               | Return
               | Assignment
Block        ::= "{" Stmt* "}"
FunctionDecl ::= "func" IDENT "(" (IDENT TYPE ("," IDENT TYPE)*)? ")" TYPE? Block
VarDecl      ::= "var" IDENT TYPE ("=" Expr)? ";"
Return       ::= "return" Expr? ";"
Assignment   ::= Expr "=" Expr ";"

Expr         ::= Term (("+" | "-") Term)*
Term         ::= Factor (("*" | "/") Factor)*
Factor       ::= FunctionCall
               | IDENT
               | STRING_LITERAL
               | CHARACTER_LITERAL
               | INTEGER_LITERAL
               | Group
FunctionCall ::= IDENT "(" (Expr ("," Expr)*)? ")"
Group        ::= "(" Expr ")"

/* Lexical tokens */

Char     ::= #x9 | #xA | #xD | [#x20-#x10FFFF]
HexDigit ::= [0-9a-fA-F]
Newline  ::= #xD #xA | #xA | #xD

TYPE  ::= [A-Z][a-zA-Z0-9]*
IDENT ::= [a-z][a-zA-Z0-9]*

INTEGER_LITERAL    ::= DecimalLiteral
                     | HexadecimalLiteral
                     | OctalLiteral
                     | BinaryLiteral
DecimalLiteral     ::= [0-9]+
HexadecimalLiteral ::= "0" [xX] HexDigit+
OctalLiteral       ::= "0" [oO] [0-7]+
BinaryLiteral      ::= "0" [bB] [01]+

STRING_LITERAL    ::= '"' (Char - ('"' | "\") | Escape)* '"'
CHARACTER_LITERAL ::= "'" (Char - ("'" | "\" | Newline) | Escape) "'"

Escape ::= "\" ("0" | "a" | "b" | "n" | "t" | "r" | "\" | "'" | '"')
         | "\x" HexDigit HexDigit
